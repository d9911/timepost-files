      "delete": {
        "operationId": "deleteFile",
        "summary": "Поставить окончательное удаление файла в очередь",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Разрешено только автономному основному ключу при FILES_DELETE_ENABLED=true. Timepost запрещает удаление до реализации учёта ссылок из постов. 202 означает очередь; файл перестаёт читаться сразу, worker удаляет байты и фиксирует deleted. Повтор допускается в deleting; после завершения 404. Worker повторяет сбои до 10 попыток; failed требует вмешательства оператора.",
        "responses": {
          "202": {
            "description": "Удаление принято, байты ещё могут находиться у провайдера.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "id",
                        "status"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "deleting"
                          ]
                        }
                      }
