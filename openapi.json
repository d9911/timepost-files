    "/api/v1/files/{id}/deletion": {
      "get": {
        "operationId": "getFileDeletion",
        "summary": "Прочитать состояние очереди удаления",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Проверяется доступ к проекту. Доступно после окончания удаления; 404, если задания нет. Повторный DELETE владельцем перезапускает только failed-задание; running не сбрасывается.",
        "responses": {
          "200": {
            "description": "Состояние и число попыток, без ответов и секретов провайдера.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "fileId",
                        "status",
                        "attempts",
                        "maxAttempts"
                      ],
                      "properties": {
                        "fileId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "pending",
                            "running",
                            "done",
                            "failed"
                          ]
                        },
                        "attempts": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "maxAttempts": {
                          "type": "integer",
                          "enum": [
                            10
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
