{
  "name": "timepost-files",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d9911/timepost-files.git"
  },
  "author": {
    "name": "Denis Gutsuliak (d9911.org)",
    "email": "admin@d9911.org",
    "url": "https://t.me/d9911/"
  },
  "contributors": [
    {
      "name": "Denis Gutsuliak",
      "email": "admin@d9911.org",
      "url": "https://t.me/d9911/"
    }
  ],
  "license": "GPL-3.0-only-or-later",
  "scripts": {
    "start": "node dist/src/server.js",
    "openapi:generate": "npm run build && node dist/scripts/openapi.js",
    "openapi:check": "npm run build && node dist/scripts/openapi.js --check",
    "test": "npm run build && node --test dist/test/*.test.js",
    "lint": "eslint src test scripts public",
    "format:check": "prettier --check src test scripts public package.json tsconfig.json eslint.config.mjs",
    "format": "prettier --write src test scripts public package.json tsconfig.json eslint.config.mjs",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node dist/scripts/build-assets.js",
    "typecheck": "tsc --noEmit",
    "openapi:docs": "npm run openapi:generate && redocly build-docs openapi.json --output documentation/index.html",
    "icons:generate": "tsc && node dist/scripts/generate-icons.js && node dist/scripts/build-assets.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.3",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@redocly/cli": "2.51.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "9.17.0",
    "openapi-types": "12.1.3",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "homepage": "https://github.com/d9911/timepost-files#readme",
  "bugs": {
    "url": "https://github.com/d9911/timepost-files/issues"
  },
  "description": "Private TypeScript file-storage service with Yandex Disk, S3-compatible and local providers, PostgreSQL metadata, a deletion worker and a management UI."
}
