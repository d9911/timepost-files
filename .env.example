# Автономный запуск: make setup создаёт .env с разными случайными ключами.
FILES_API_KEY=
FILES_READONLY_API_KEY=
FILES_DB_PASSWORD=
FILES_PORT=3060
# simulator — явный локальный режим; yandex — настоящая интеграция с Диском.
STORAGE_PROVIDER=simulator
YANDEX_DISK_OAUTH_TOKEN=
# Для запуска Node.js без Compose:
PORT=3050
DATABASE_URL=
FILES_AUTH_MODE=api-key
FILES_GENERIC_ENABLED=true
FILES_DELETE_ENABLED=true
FILES_UI_ENABLED=true
FILES_CONTENT_PREFIX=
STORAGE_DIRECTORY=/data/objects
# Для интеграции Timepost задайте FILES_AUTH_MODE=timepost и адреса/секреты:
ACCOUNTS_SERVICE_URL=http://127.0.0.1:3001
PROJECTS_SERVICE_URL=http://127.0.0.1:3010
SYSTEM_JWT_SECRET=
SYSTEM_JWT_ISSUER=sm-internal-services
SYSTEM_JWT_AUDIENCE=sm-internal-services
